{
  "name": "backlog-kanban",
  "displayName": "Backlog Kanban",
  "description": "backlog スキルのバックログを VSCode にカンバン表示する拡張機能",
  "version": "0.0.1",
  "publisher": "shinshu68",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shinshu68/backlog-kanban.git"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "backlogKanban.open",
        "title": "カンバンを開く",
        "category": "Backlog Kanban"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.144.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "7.0.2"
  }
}
